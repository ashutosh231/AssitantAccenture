# AWS Region for Transcribe and Bedrock (e.g. us-east-1)
AWS_REGION=us-east-1

# Amazon Transcribe language code (e.g. en-US, en-IN, en-GB)
AWS_TRANSCRIBE_LANGUAGE_CODE=en-US

# Amazon Bedrock Model ID
BEDROCK_MODEL_ID=openai.gpt-6.1-terra

# Amazon Cognito Identity Pool ID for secure browser credential retrieval
# Format: region:guid (e.g. us-east-1:12345678-abcd-1234-efgh-1234567890ab)
AWS_COGNITO_IDENTITY_POOL_ID=your-identity-pool-id

# Optional for local personal testing (or configure via in-app Settings drawer)
# Never commit permanent AWS keys to version control or production builds.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
